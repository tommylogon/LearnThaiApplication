<Window x:Class="LearnThaiApplication.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LearnThaiApplication"
        
        mc:Ignorable="d"
        Title="Learn Thai" Height="600" Width="1000" 
        Background="{StaticResource PrimaryBackgroundBrush}">
    <!-- Window.Resources removed, b2v moved to App.xaml -->
    <Grid> <!-- Replaced Viewbox with Grid -->
        
            <TabControl x:Name="MainWindow_tabController" 
                        SelectionChanged="OnTabChanged" 
                        Width="{Binding Path=W_Width}" Height="{Binding Path=W_Height}"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <!-- Removed inline Background, Foreground. Style will be applied from App.xaml -->
            <!-- TabControl.Resources removed -->
                <TabItem Header="Learn the language"> <!-- Removed Margin -->
                <Grid Background="{StaticResource SecondaryBackgroundBrush}" >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="450"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/> <!-- Adjusted for content -->
                            <RowDefinition Height="Auto"/> <!-- Adjusted for content -->
                            <RowDefinition Height="*"/>    <!-- Remaining space for description -->
                            <RowDefinition Height="Auto"/> <!-- Adjusted for content -->
                        </Grid.RowDefinitions>

                        <Grid x:Name="SettingsGroup" Grid.Column="0" Grid.Row="0" Grid.RowSpan="3" Margin="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Label x:Name="lbl_Points" Grid.Column="0" Grid.Row="0" Content="{Binding Path=CorrectPoints}" />
                            <TextBlock x:Name="lbl_Chapter_Page1" Grid.Column="0" Grid.Row="1" Text="Chapter:" Style="{StaticResource BaseTextBlockStyle}" />
                            <ComboBox x:Name="cb_Chapter_Page1" Grid.Column="0" Grid.Row="2"
                                      ItemsSource="{Binding Path=Chapters, Mode=TwoWay, NotifyOnSourceUpdated=True, UpdateSourceTrigger=PropertyChanged}" DisplayMemberPath="ChapterName"
                                      SelectedIndex="{Binding Path=SelectedChapterIndex, Mode=TwoWay, NotifyOnSourceUpdated=True, UpdateSourceTrigger=PropertyChanged}"  SelectedValuePath="Content" SelectionChanged="ChapterChanged" />
                            
                            <TextBlock x:Name="txb_ChapterCounter" Grid.Column="1" Grid.Row="2" VerticalAlignment="Center" Margin="5,0,0,0"
                                       Text="{Binding Path=ChapterCounter }" Style="{StaticResource BaseTextBlockStyle}" />

                            <TextBlock x:Name="lbl_ChapterCount" Grid.Column="1" Grid.Row="3" Text="{Binding Path=CurrentWord}" Style="{StaticResource BaseTextBlockStyle}" />
                            <StackPanel Grid.Column="0" Grid.Row="4"> <!-- Removed Grid.ColumnSpan="2" -->
                                <CheckBox x:Name="cbk_hideText" Content="Show text" IsChecked="True"/>
                                <CheckBox x:Name="ckb_DescBox" Content="Description" 
                                          IsChecked="{Binding Path=HasDescription}" VerticalAlignment="Top" Checked="DescriptionBox_Checked" Unchecked="DescriptionBox_Checked" />
                                <CheckBox x:Name="ckb_Randomized" Content="Randomize words" HorizontalAlignment="Left"
                                          IsChecked="{Binding Path=IsRandom}" VerticalAlignment="Top" Checked="Randomized_Checked" Unchecked="Randomized_Checked" />
                                <Label x:Name="lbl_TrainWhat_Page1" Content="What to train" HorizontalAlignment="Left" VerticalAlignment="Top" />
                                <RadioButton x:Name="rb_TrainScript_Page1" 
                                             IsChecked="{Binding Path=TrainScript, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True}"
                                             GroupName="TrainWhat" Content="Writhing Thai" HorizontalAlignment="Left" VerticalAlignment="Top" Checked="SelectWhatToPractice" />
                                <RadioButton x:Name="rb_TrainEngWords_Page1" 
                                             IsChecked="{Binding Path=TrainWords, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True}"
                                             GroupName="TrainWhat" Content="English meanings" HorizontalAlignment="Left" VerticalAlignment="Top" Checked="SelectWhatToPractice" />
                                <RadioButton x:Name="rb_TrainFonet_Page1" 
                                             IsChecked="{Binding Path=TrainFonet, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True}"
                                             GroupName="TrainWhat" Content="Pronounciations" HorizontalAlignment="Left" VerticalAlignment="Top" Checked="SelectWhatToPractice" />
                            </StackPanel>
                        </Grid>

                        <ScrollViewer Grid.Column="1" Grid.Row="0" Grid.ColumnSpan="2">
                            <TextBlock x:Name="txb_ThaiScript_Page1" Text="{Binding Path=ThaiScriptString}" Style="{StaticResource PageTitleStyle}" Visibility="{Binding Path=IsChecked, ElementName=cbk_hideText, Converter={StaticResource b2v}}" />
                        </ScrollViewer>

                        <Grid x:Name="InputGroup" Grid.Column="1" Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>      <!-- Textbox and buttons -->
                                <ColumnDefinition Width="Auto"/>   <!-- Speaker/Listen buttons -->
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- Input TextBox -->
                                <RowDefinition Height="Auto"/> <!-- Prev/Check/Next Buttons -->
                                <RowDefinition Height="Auto"/> <!-- Status TextBlock -->
                            </Grid.RowDefinitions>
                            
                            <TextBox x:Name="txt_Answear_Page1" Grid.Column="0" Grid.Row="0" TextWrapping="Wrap"
                                     Text="{Binding Mode=TwoWay, Path=Answear, UpdateSourceTrigger=PropertyChanged}" KeyUp="OnKeyUp" />
                            <Grid Grid.Column="0" Grid.Row="1" >
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="btn_Prev_Word" Content="Prev" Grid.Column="0" Click="PrevWord" Style="{StaticResource NavigationButtonStyle}" />
                                <Button x:Name="btn_validate" Content="Check" Grid.Column="1" Click="ValidateAnswear" Style="{StaticResource NavigationButtonStyle}" />
                                <Button x:Name="btn_Next_Word" Content="Next" Grid.Column="2" Click="NextWord" Style="{StaticResource NavigationButtonStyle}" />
                            </Grid>

                            <TextBlock x:Name="txb_Status_Page1" Grid.Column="0" Grid.Row="2" TextWrapping="Wrap"
                                       Text="{Binding Path=Result}" Style="{StaticResource StatusTextStyle}" />
                            
                            <StackPanel Grid.Column="1" Grid.Row="0" Grid.RowSpan="2" Orientation="Vertical" Margin="5,0,0,0">
                                <Button x:Name="btn_Speaker_Page1" Content="" Grid.Column="0" Grid.Row="0" Click="PlaySound_Clicked" Style="{StaticResource IconButtonStyle}" ToolTip="Play Thai pronunciation"/>
                                <Button x:Name="button" Content="Listen to word" Grid.Column="1" Grid.Row="0" Click="TestWordReco" />
                                <Button Content="Clear this word" Grid.Column="0" Grid.Row="1" Click="ClearWord_Clicked"/>
                            </StackPanel>
                        </Grid>

                        <ScrollViewer x:Name="scrvr_Description_page1" Grid.Column="0" Grid.Row="2" Grid.ColumnSpan="3" Grid.RowSpan="2">
                            <TextBox x:Name="txb_Description_page1" Text="{Binding Path=DescriptionString}" Style="{StaticResource ReadOnlyDescriptionTextBoxStyle}" />
                        </ScrollViewer>

                        <TextBlock x:Name="txb_SpeechResult" Grid.Column="2" Grid.Row="1" TextWrapping="Wrap" 
                                   Text="{Binding Path=SpeechResult, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True, Mode=OneWay}" Style="{StaticResource PageTitleStyle}" />
                    </Grid>
                </TabItem>

                <TabItem Header="Manage content"> 
               <Grid Background="{StaticResource SecondaryBackgroundBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <!-- The second ColumnDefinition is removed as DataGrid spans both columns -->
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Changed from 30 -->
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <DataGrid x:Name="dg_ContentManagement"
                              Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="2"
                              ItemsSource="{Binding Path=SearchResults, Mode=TwoWay, NotifyOnSourceUpdated=True, UpdateSourceTrigger=PropertyChanged}"
                              SelectedIndex="{Binding Path=ManagementIndex, Mode=TwoWay,NotifyOnSourceUpdated=True, UpdateSourceTrigger=PropertyChanged}"
                              LoadingRow="Dg_ContentManagement_LoadingRow" RowEditEnding="RowEditEnding" KeyUp="DG_ConMan_KeyUp">
                            <!-- Removed inline Background, RowBackground, Foreground, AutoGenerateColumns, CanUserDeleteRows, SelectionMode, SelectionUnit - Handled by DataGridStyles.xaml -->
                            <!-- Removed DataGrid.Resources for ColumnHeader style, handled by DataGridStyles.xaml -->
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Chapter" Binding="{Binding Path=Chapter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxWidth="190" />
                                <DataGridTextColumn Header="Thai Script" Binding="{Binding Path=ThaiScript_String, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" CellStyle="{StaticResource CustomDataGridCellStyle}" MaxWidth="350" />
                                <DataGridTextColumn Header="Thai Fonetical" Binding="{Binding Path=ThaiFonet_String, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxWidth="150"/>
                                <DataGridTextColumn Header="English meaning" Binding="{Binding Path=EngWords_String, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxWidth="250"/>
                                <DataGridTextColumn Header="Description" Binding="{Binding Path=EngDesc, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxWidth="250"/>
                                <DataGridTextColumn Header="Tone" Binding="{Binding Path=Tone_String, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxWidth="150"/>
                                <DataGridTextColumn Header="Sound Path" Binding="{Binding Path=SoundPath_String, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding Path=SoundPathCellVisability, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True}" MaxWidth="450"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Grid Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>       <!-- Search TextBox -->
                                <ColumnDefinition Width="Auto"/>    <!-- Search Button -->
                                <ColumnDefinition Width="Auto"/>    <!-- CheckBox -->
                            </Grid.ColumnDefinitions>
                        
                            <TextBox x:Name="txt_SearchBar" Grid.Column="0" Text="{Binding SearchString, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" KeyUp="Search_KeyUp" />
                            <Button x:Name="btn_Search" Content="Search" Grid.Column="1" Click="Search_Clicked" />
                            <CheckBox x:Name="ckb_EnableSoundPath" Grid.Column="2" Content="Show sound path" IsChecked="{Binding Path=HideSoundPath}"/>
                        </Grid>
                    </Grid>
                </TabItem>
                <TabItem Header="Settings">
                <Grid Background="{StaticResource SecondaryBackgroundBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Changed to Auto -->
                            <RowDefinition Height="Auto"/> <!-- Changed to Auto -->
                            <RowDefinition Height="*"/>    <!-- Takes remaining space -->
                        </Grid.RowDefinitions>

                        <Grid Grid.Column="0" Grid.Row="0" Margin="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/> <!-- Changed from 100 -->
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/> <!-- Changed from 100 -->
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- Changed from 40 -->
                                <RowDefinition Height="Auto"/> <!-- Changed from 40 -->
                                <RowDefinition Height="Auto"/> <!-- Changed from 40 -->
                            </Grid.RowDefinitions>
                            
                            <Label Content="Language Path:" Grid.Column="0" Grid.Row="0" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Grid.Row="0" TextWrapping="Wrap" Text="{Binding LanguageFilePath}" MinWidth="120" VerticalAlignment="Center"/>
                            <Button Content="Browse" Grid.Column="2" Grid.Row="0" Click="LanguagePath_Clicked" VerticalAlignment="Center"/>

                            <Label Grid.Column="0" Grid.Row="1" Content="Sound Path:" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Grid.Row="1" TextWrapping="Wrap" Text="{Binding SoundFilePath}" MinWidth="120" VerticalAlignment="Center"/>
                            <Button Grid.Column="2" Grid.Row="1" Content="Browse" Click="SoundPath_Clicked" VerticalAlignment="Center"/>

                            <Label Grid.Column="0" Grid.Row="2" Content="Web File Path:" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Grid.Row="2" TextWrapping="Wrap" Text="{Binding WebFilePath}" MinWidth="120" VerticalAlignment="Center"/>
                            <Button Grid.Column="2" Grid.Row="2" Content="Browse" Click="WebFilePath_Clicked" VerticalAlignment="Center"/>
                        </Grid>

                        <StackPanel Grid.Column="0" Grid.Row="1" Margin="10">
                            <Label x:Name="lbl_TrainWhat_Page2_Copy1" Content="What to train" />
                            <RadioButton x:Name="rb_TrainScript_Setting"
                                         IsChecked="{Binding Path=TrainScript, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True}"
                                         Content="Writhing Thai" Checked="SelectWhatToPractice" GroupName="TrainWhat" />
                            <RadioButton x:Name="rb_TrainEngWords_Setting"
                                         IsChecked="{Binding Path=TrainWords, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True}"
                                         Content="English meanings" Checked="SelectWhatToPractice" GroupName="TrainWhat" />
                            <RadioButton x:Name="rb_TrainFonet_Setting"
                                         IsChecked="{Binding Path=TrainFonet, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True}"
                                         Content="Pronounciations" Checked="SelectWhatToPractice" GroupName="TrainWhat" />
                        </StackPanel>

                        <Grid Grid.Column="0" Grid.Row="2" Margin="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/> <!-- Changed from 150 -->
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- All changed from fixed height -->
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <ComboBox x:Name="cb_SelectList" Grid.Column="0" Grid.Row="0"
                                      ItemsSource="{Binding Path=Chapters, Mode=TwoWay, NotifyOnSourceUpdated=True, UpdateSourceTrigger=PropertyChanged}"
                                      SelectedIndex="{Binding Path=SelectedChapterIndex, Mode=TwoWay, NotifyOnSourceUpdated=True, UpdateSourceTrigger=PropertyChanged}"
                                      VerticalAlignment="Center" Width="120" SelectionChanged="CheckSoundChapter_Changed" />
                            <Button Grid.Column="1" Grid.Row="0" Content="Find sound files" Click="StartSoundDownload" />
                            <Button Content="Check sound status" Grid.Column="1" Grid.Row="1" Click="CheckSoundStatus_Clicked" />
                            <Button Content="Delete sound paths" Grid.Column="1" Grid.Row="2" Click="RemoveSoundPath" />
                            <Button Content="Set SoundPaths" Grid.Column="1" Grid.Row="3" Click="SetSoundPath_clicked" />
                            <Button Content="Print all words" Grid.Column="1" Grid.Row="4" Click="PrintAllWordsToFile" />
                            <ProgressBar Minimum="0" Maximum="100" Grid.ColumnSpan="2" Grid.Row="5" Margin="0,5,0,0"
                                         Value="{Binding Path=ProgressValue}" Name="pbStatus" VerticalAlignment="Bottom" />
                        </Grid>

                        <Grid Grid.Row="1" Grid.Column="1" Margin="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- Was 25 -->
                                <RowDefinition Height="Auto"/> <!-- Was 15 -->
                                <RowDefinition Height="Auto"/> <!-- Was 15 -->
                                <RowDefinition Height="Auto"/> <!-- Was 15 -->
                                <RowDefinition Height="Auto"/> <!-- Was 15 -->
                                <RowDefinition Height="Auto"/> <!-- Was 15 -->
                                <RowDefinition Height="Auto"/> <!-- Was 15 -->
                            </Grid.RowDefinitions>
                            <Label Grid.Column="0" Grid.Row="0" Content="Toggle settings" /> <!-- Removed explicit Horizontal/VerticalAlignment -->
                            <CheckBox Grid.Column="0" Grid.Row="1" x:Name="ckb_LoopChapter" IsChecked="{Binding Path=IsLooping}" Content="Loop chapter" Checked="LoopChapter_Checked" Unchecked="LoopChapter_Checked" /> <!-- Removed explicit Horizontal/VerticalAlignment -->
                            <CheckBox x:Name="ckb_DescBox_Setting" Grid.Column="1" Grid.Row="1" IsChecked="{Binding Path=HasDescription}" Content="Description" Checked="DescriptionBox_Checked" Unchecked="DescriptionBox_Checked" />
                            <CheckBox x:Name="ckb_Randomized_Setting" Grid.Column="0" Grid.Row="2" IsChecked="{Binding Path=IsRandom}" Content="Randomize words" Checked="Randomized_Checked" Unchecked="Randomized_Checked" />
                            <CheckBox x:Name="ckb_FullDesc" Grid.Column="1" Grid.Row="2" IsChecked="{Binding Path=DisplayAll}" Content="Full description?" />
                            <CheckBox x:Name="ckb_AutoPlay" Grid.Column="0" Grid.Row="3" IsChecked="{Binding Path=AutoPlay}" Content="Auto play sounds" Checked="AutoPlay_Checked" Unchecked="AutoPlay_Checked" /> <!-- Removed Background="White" and explicit alignments -->
                            <CheckBox x:Name="ckb_SkipIntro" Grid.Column="1" Grid.Row="3" IsChecked="{Binding Path=SkipIntro}" Content="Skip intro message" Checked="SkipMessage_Checked" Unchecked="SkipMessage_Checked" /> <!-- Removed explicit HorizontalAlignment -->
                            <CheckBox x:Name="ckb_showSaveLocation" Grid.Column="0" Grid.Row="4" IsChecked="{Binding Path=ShowSaveLocation}" Content="Show save location" Checked="LoopChapter_Checked" Unchecked="LoopChapter_Checked" />
                            <CheckBox x:Name="ckb_SkipCompletedWords" Grid.Column="1" Grid.Row="4" IsChecked="{Binding Path=SkipCompleted}" Content="Skip completed words" Checked="LoopChapter_Checked" Unchecked="LoopChapter_Checked" />
                            <CheckBox x:Name="ckb_Listen" IsChecked="{Binding Path=IsListening}" Grid.Column="0" Grid.Row="5" Content="Speach Recognition" Checked="Listen_Checked" Unchecked="Listen_Checked" />
                            <CheckBox x:Name="ckb_setting_7_Copy2" IsChecked="False" Grid.Column="1" Grid.Row="5" Content="setting" Checked="LoopChapter_Checked" Unchecked="LoopChapter_Checked" />
                            <CheckBox x:Name="ckb_setting_7_Copy3" IsChecked="False" Grid.Column="0" Grid.Row="6" Content="setting" Checked="LoopChapter_Checked" Unchecked="LoopChapter_Checked" />
                            <CheckBox x:Name="ckb_setting_7_Copy4" IsChecked="False" Grid.Column="1" Grid.Row="6" Content="setting" Checked="LoopChapter_Checked" Unchecked="LoopChapter_Checked" />
                        </Grid>

                        <Grid Grid.Column="2" Grid.Row="0" Margin="5" HorizontalAlignment="Right">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/> <!-- Was 150 -->
                                <ColumnDefinition Width="Auto"/> <!-- Was 150 -->
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- Was 25 -->
                                <RowDefinition Height="Auto"/> <!-- Was 25 -->
                                <RowDefinition Height="Auto"/> <!-- Was 25 -->
                                <RowDefinition Height="Auto"/> <!-- Was 25 -->
                                <RowDefinition Height="Auto"/> <!-- Was 25 -->
                                <RowDefinition Height="Auto"/> <!-- Was * -->
                            </Grid.RowDefinitions>

                        <Button Grid.Column="0" Grid.Row="0" x:Name="btn_ClearCurrentUserList" Content="Clear known words"     Click="ClearCurrentUserKnownWords" />
                            <ComboBox x:Name="comboBox" Grid.Column="1" Grid.Row="0"  ItemsSource="{Binding Path=Users}"    DisplayMemberPath="UserName" SelectedItem="{Binding Path=CurrentUser,Mode=OneWay}" />

                            <Label x:Name="label" Grid.Column="0" Grid.Row="1" Content="Voice"   />
                        <ComboBox x:Name="cb_Voices" Grid.Column="1" Grid.Row="1" ItemsSource="{Binding Path=Voices}"  SelectionChanged="Cb_Voices_SelectionChanged" DisplayMemberPath="VoiceInfo.Name" SelectedItem="{Binding Path=CurrentVoice, Mode=OneWay}"
                               />


                            
                        <Label Grid.Column="0" Grid.Row="2" Content="Windows Width" HorizontalAlignment="Left"  VerticalAlignment="Top" />
                        <TextBox x:Name="txt_WinWidth" Grid.Column="1" Grid.Row="2" HorizontalAlignment="Left" Height="23"  TextWrapping="Wrap" Text="{Binding  Path=W_Width}" VerticalAlignment="Top" Width="120"/>
                            <Slider Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Minimum="400" Maximum="1920" Value="{Binding Path=W_Width}"/>

                        <Label Grid.Column="0" Grid.Row="4" Content="Window height" VerticalAlignment="Center" /> <!-- Was Window height; -->
                        <TextBox x:Name="txt_WinHeight" Grid.Column="1" Grid.Row="4" TextWrapping="Wrap" Text="{Binding Path=W_Height}" VerticalAlignment="Center" Width="120"/> <!-- Removed explicit Height -->
                            <Slider Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Minimum="400" Maximum="1200" Value="{Binding Path=W_Height}"/>
                        </Grid>

                        <Button Grid.Column="2" Grid.Row="2" x:Name="btn_SaveSettings" Content="Save settings" HorizontalAlignment="Right" VerticalAlignment="Bottom" Click="SaveSettings_Click" /> <!-- Corrected Grid.Column from 5 to 2 -->

                    </Grid>
                </TabItem>

            </TabControl>
    </Grid>
</Window>