<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Colors.xaml"/>
        <ResourceDictionary Source="Typography.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <Style TargetType="Label" x:Key="BaseLabelStyle">
        <Setter Property="Foreground" Value="{StaticResource SecondaryForegroundBrush}"/> <!-- Using the existing light blueish text color -->
        <Setter Property="FontSize" Value="{StaticResource FontSizeNormal}"/>
        <Setter Property="Padding" Value="5"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!-- Default Label style -->
    <Style TargetType="Label" BasedOn="{StaticResource BaseLabelStyle}"/>

</ResourceDictionary>
