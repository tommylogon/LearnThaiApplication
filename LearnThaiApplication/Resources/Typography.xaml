<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Font Sizes -->
    <x:Double x:Key="FontSizeSmall">10</x:Double>
    <x:Double x:Key="FontSizeNormal">12</x:Double>
    <x:Double x:Key="FontSizeMedium">14</x:Double>
    <x:Double x:Key="FontSizeLarge">18</x:Double>
    <x:Double x:Key="FontSizeExtraLarge">24</x:Double>
    <x:Double x:Key="FontSizeHuge">32</x:Double>
    <x:Double x:Key="FontSizePageTitle">48</x:Double> <!-- For Thai script, etc. -->
    <x:Double x:Key="DataGridCellFontSize">16</x:Double> <!-- Adjusted from 42 -->

    <!-- Base TextBlock Style -->
    <Style TargetType="TextBlock" x:Key="BaseTextBlockStyle">
        <Setter Property="Foreground" Value="{StaticResource PrimaryForegroundBrush}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeNormal}"/>
        <Setter Property="TextWrapping" Value="NoWrap"/>
    </Style>

    <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}" x:Key="PageTitleStyle">
        <Setter Property="FontSize" Value="{StaticResource FontSizePageTitle}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    
    <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}" x:Key="StatusTextStyle">
        <Setter Property="FontSize" Value="{StaticResource FontSizeExtraLarge}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}" x:Key="DescriptionTextStyle">
        <Setter Property="FontSize" Value="{StaticResource FontSizeExtraLarge}"/> <!-- Was 24 -->
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

</ResourceDictionary>
